# Copy this file to keystore.properties at the project root (gitignored).
# Do not commit real passwords or keystore binaries.
#
# storeFile is resolved relative to the :app module directory, e.g.:
#   ../dimagpay-release.jks
#   C:/path/to/dimagpay-release.jks
#
# Build signed artifacts:
#   ./gradlew :app:assembleRelease
#   ./gradlew :app:bundleRelease

storeFile=../your-release-key.jks
storePassword=your-store-password
keyAlias=dimagpay
keyPassword=your-key-password
